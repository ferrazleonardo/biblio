@Article{Oushiro2020,
  author       = {Livia Oushiro},
  date         = {2020},
  journaltitle = {University of Pennsylvania Working Papers in Linguistics},
  title        = {Contrasting Age of Arrival and Length of Residence in Dialect Contrasting Age of Arrival and Length of Residence in Dialect Contact},
  issue        = {2},
  pages        = {79--88},
  url          = {https://repository.upenn.edu/pwpl/vol25/iss2/10},
  volume       = {25},
  abstract     = {This paper reports on the analyses of a corpus built to disentangle the effects of Age of Arrival and Length of Residence in the dialect contact situation of rural Northeastern migrants living in the Southeastern city of Campinas/Brazil. These dialectal areas differ both in Northern-Southern and in ruralurban linguistic traits. Mixed-effects models of four sociolinguistics variables (i) coda /r/ (porta 'door'); (ii) /t, d/ before [i] (tia 'aunt', dia 'day'); (iii) sentential negation (não vi vs. não vi não/vi não 'I haven't seen'); and (iv) nominal agreement (os menino-s vs. os menino-ø 'the boys') show that Age of Arrival correlates only with the phonetic variables and Length of Residence correlates only with coda /r/. Self-reported identity indices align with the variables' geographical distribution, correlating with coda /r/ and negation (the Northern-Southern variables) but not with /t, d/ and nominal agreement (the rural-urban variables). Thus, while Age of Arrival and Length of Residence distinguish phonetic and morphosyntactic variables, dialect acquisition also involves a complex web of differently defined regional identities.},
  file         = {:/Users/leonardoferraz/Documents/[Textos] Contato dialetal/Oushiro (2020b).pdf:PDF},
}

